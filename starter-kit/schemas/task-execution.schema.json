{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ios3kov/AE-Development-Rules/task-execution-v1",
  "title": "Optional task execution and review record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "candidate"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "TODO",
              "READY",
              "RUNNING",
              "DONE",
              "BLOCKED"
            ]
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "ready_conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "met": {
                  "type": "boolean"
                }
              },
              "required": [
                "condition",
                "met"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "budget": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              },
              "spent": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "unit",
              "limit",
              "spent"
            ],
            "additionalProperties": false
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "device",
                    "cache",
                    "output"
                  ]
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "read",
                    "exclusive"
                  ]
                }
              },
              "required": [
                "kind",
                "key",
                "mode"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "result": {
            "type": "object",
            "properties": {
              "candidate": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "changed_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "candidate",
              "summary",
              "changed_paths",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "owner",
          "acceptance",
          "status",
          "allowed_paths",
          "depends_on",
          "ready_conditions",
          "budget",
          "resources"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "DONE"
                }
              }
            },
            "then": {
              "required": [
                "result"
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "integration_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "candidate": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "candidate",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "required": [
                "evidence_ids"
              ]
            },
            "else": {
              "required": [
                "reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "NOT_RUN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "NOT_RUN"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "consequence": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "resolved": {
                "type": "boolean"
              },
              "resolution_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "location",
              "consequence",
              "basis",
              "blocking",
              "resolved"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "blocking": {
                      "const": true
                    },
                    "resolved": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "resolution_evidence_ids"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "candidate",
        "reviewer",
        "spec",
        "quality",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "evidence",
    "tasks",
    "integration_checks",
    "review"
  ],
  "additionalProperties": false
}
