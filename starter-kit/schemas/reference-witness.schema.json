{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reference-witness.schema.json",
  "description": "Semantic policy, file integrity and witness checks are implemented by the CLI; schema validation alone cannot establish PASS.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "reference_triggered": {
          "type": "boolean"
        },
        "candidate_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reference_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "required_cases": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "positive",
                    "negative",
                    "malformed",
                    "boundary",
                    "cancellation",
                    "recovery"
                  ]
                }
              },
              "required_authority": {
                "enum": [
                  "static",
                  "unit",
                  "integration",
                  "runtime",
                  "packaged-process",
                  "host",
                  "device"
                ]
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "exclusion_reason": {
                "type": "string",
                "minLength": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "required",
              "required_authority",
              "requirement_ids",
              "check_id"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "required": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "required_cases"
                  ],
                  "properties": {
                    "required_cases": {
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "required": [
                    "exclusion_reason",
                    "decision_ref"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "reference_triggered"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reference_triggered": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "candidate_revision",
              "reference_sha256",
              "obligations"
            ]
          }
        }
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "const": "APPROVED"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "original_cases",
              "fixtures",
              "verifier"
            ]
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runner_id": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "evidence_id",
          "obligation_id",
          "role",
          "record_sha256",
          "runner_id",
          "review_status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "policy",
    "reviewer_id",
    "review_status",
    "reviewed_at",
    "expires_at",
    "captures"
  ]
}
