{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ios3kov/AE-Development-Rules/native-review-v1",
  "title": "Optional native review coverage record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "candidate"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "REVIEWED",
              "UNREVIEWED",
              "BLOCKED"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "areas": {
            "type": "object",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "status",
                  "basis"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "PASS"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ids"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              },
              "numeric": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "status",
                  "basis"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "PASS"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ids"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              },
              "ownership": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "status",
                  "basis"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "PASS"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ids"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              },
              "concurrency": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "status",
                  "basis"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "PASS"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ids"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              },
              "units": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "NOT_RUN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "status",
                  "basis"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "PASS"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ids"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "memory",
              "numeric",
              "ownership",
              "concurrency",
              "units"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "sha256",
          "status",
          "basis"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "REVIEWED"
                }
              }
            },
            "then": {
              "required": [
                "areas"
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unit_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "input_unit": {
            "type": "string",
            "minLength": 1
          },
          "output_unit": {
            "type": "string",
            "minLength": 1
          },
          "conversion": {
            "type": "string",
            "minLength": 1
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "quantity",
          "input_unit",
          "output_unit",
          "conversion",
          "invariant",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "evidence",
    "inventory",
    "unit_contracts"
  ],
  "additionalProperties": false
}
