{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural schema only. agent_skills.py enforces actual bytes, paths, exact external policy pin, lifecycle ownership and admission. No security/effectiveness/host certification.",
  "title": "Agent skills scan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scan_status": {
      "enum": [
        "complete",
        "incomplete",
        "unavailable"
      ]
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          }
        },
        "required": [
          "path",
          "size",
          "sha256",
          "mode"
        ]
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "process",
              "network",
              "credentials"
            ]
          }
        },
        "required": [
          "path",
          "category"
        ]
      }
    },
    "scanner_id": {
      "type": "string",
      "minLength": 1
    },
    "scanner_version": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "omissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security_certified": {
      "const": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "scan_status",
    "package_sha256",
    "files",
    "findings",
    "scanner_id",
    "scanner_version",
    "config_sha256",
    "check_ids",
    "errors",
    "omissions",
    "security_certified",
    "scope"
  ]
}
