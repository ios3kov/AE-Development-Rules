{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observer-only skill evaluation fixture extension v1",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "partition",
          "request",
          "should_select_skill",
          "files",
          "edit_paths",
          "checks",
          "objectives",
          "observer_files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "enum": [
              "tune",
              "select",
              "final"
            ]
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "should_select_skill": {
            "type": "boolean"
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "edit_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "critical",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "kind": {
                  "enum": [
                    "file_equals",
                    "json_equals",
                    "command_pass",
                    "action_count",
                    "final_claim"
                  ]
                },
                "arm": {
                  "enum": [
                    "baseline",
                    "selected_skill"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "value": {},
                "alias": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "read",
                    "write",
                    "check",
                    "select_skill",
                    "read_skill_resource",
                    "finish"
                  ]
                },
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "observer_files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
