{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural schema only. agent_skills.py enforces actual bytes, paths, exact external policy pin, lifecycle ownership and admission. No security/effectiveness/host certification.",
  "title": "Agent skills installed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4194304
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 511
                }
              },
              "required": [
                "path",
                "size",
                "sha256",
                "mode"
              ]
            },
            "uniqueItems": true
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "package_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source_commit",
                "package_sha256"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "source_commit",
          "package_sha256",
          "files",
          "history"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "skills"
  ]
}
