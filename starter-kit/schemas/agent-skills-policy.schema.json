{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural schema only. agent_skills.py enforces actual bytes, paths, exact external policy pin, lifecycle ownership and admission. No security/effectiveness/host certification.",
  "title": "Agent skills policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "candidate",
              "allowed",
              "rejected",
              "revoked"
            ]
          },
          "tasks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isolation_profile": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "submitter_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "APPROVED",
                  "PENDING",
                  "REJECTED"
                ]
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "reviewer_id",
              "submitter_id",
              "status",
              "reviewed_at",
              "expires_at"
            ]
          },
          "scan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "incomplete",
                  "unavailable"
                ]
              },
              "scanner_id": {
                "type": "string",
                "minLength": 1
              },
              "runner_id": {
                "type": "string",
                "minLength": 1
              },
              "package_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "files": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4194304
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    }
                  },
                  "required": [
                    "path",
                    "size",
                    "sha256",
                    "mode"
                  ]
                },
                "uniqueItems": true
              },
              "findings_reviewed": {
                "type": "boolean"
              },
              "scanner_version": {
                "type": "string",
                "minLength": 1
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "check_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "errors": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "omissions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "scanner_id",
              "runner_id",
              "package_sha256",
              "files",
              "findings_reviewed",
              "scanner_version",
              "config_sha256",
              "check_ids",
              "errors",
              "omissions"
            ]
          }
        },
        "required": [
          "name",
          "source",
          "source_commit",
          "purpose",
          "license",
          "package_sha256",
          "status",
          "tasks",
          "required_tools",
          "isolation_profile",
          "review",
          "scan"
        ]
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 0
    },
    "telemetry_enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "candidate_revision",
    "entries",
    "exceptions"
  ]
}
